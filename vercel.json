{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/images/:path*", "destination": "https://media.nadaun.co/photo/:path*" },
    { "source": "/:category(editorial|corporate|collaboration|concert-festival|external-event|poster|lookbook|magazine|portrait|actor-profile|business-profile|company-profile|couple|family)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
