{
  "functions": {
    "api/share.js": { "includeFiles": "index.html" },
    "api/share-image.js": { "includeFiles": "index.html" }
  },
  "routes": [
    { "src": "/", "has": [{ "type": "query", "key": "project" }], "dest": "/api/share" },
    { "src": "/share-image/(?<project>\\d+)\\.webp", "dest": "/api/share-image?project=$project" },
    { "src": "/(?<category>editorial|corporate|collaboration|concert-festival|external-event|poster|lookbook|magazine|portrait|actor-profile|business-profile|company-profile|couple|family)/", "dest": "/api/share?category=$category&_canonical=1" },
    { "src": "/(?<category>editorial|corporate|collaboration|concert-festival|external-event|poster|lookbook|magazine|portrait|actor-profile|business-profile|company-profile|couple|family)", "dest": "/api/share?category=$category" },
    {
      "src": "/images/(.*)",
      "dest": "https://media.nadaun.co/photo/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)\\.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
