{
  "$schema": "https://unpkg.com/wrangler@4.107.0/config-schema.json",
  "name": "nadaun-photo-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "photo.nadaun.co", "custom_domain": true, "zone_name": "nadaun.co" }
  ],
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*","!/ads.txt","!/apple-touch-icon.png","!/category-navigation.js","!/contact.css","!/contact.js","!/favicon-128.png","!/favicon-16.png","!/favicon-192.png","!/favicon-32.png","!/favicon-48.png","!/favicon-512.png","!/favicon-64.png","!/favicon-96.png","!/favicon.ico","!/indexnow-verification.txt","!/nadaun-portfolio.html","!/photo-share.css","!/photo-share.js","!/photo-viewer-mobile.css","!/robots.txt","!/services-guide.html","!/sitemap.xml","!/viewer-cursor.js"],
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "build": {
    "command": "node cloudflare/prepare-assets.mjs"
  }
}
