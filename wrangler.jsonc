{
  "$schema": "https://unpkg.com/wrangler@4.107.0/config-schema.json",
  "name": "nadaun-photo-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "build": {
    "command": "node cloudflare/prepare-assets.mjs"
  }
}
